# Copy to deploy/.env on the server and fill in. Never commit deploy/.env.

# Your domain(s), pointed at the VPS IP with DNS "A" records.
DOMAIN=gratiaestates.com, www.gratiaestates.com
FRONTEND_ORIGIN=https://gratiaestates.com

# Database (only reachable inside the server).
POSTGRES_DB=gratia
POSTGRES_USER=gratia
POSTGRES_PASSWORD=change-me-long-random

# Generate each with: openssl rand -hex 32
JWT_SECRET_KEY=change-me
JWT_REFRESH_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Owner sign-in (OTP only).
VIDEO_ADMIN_EMAIL=owner@example.com
OWNER_PHONE_NUMBER=+910000000000
NTFY_TOPIC=your-private-ntfy-topic

# Optional real email / SMS delivery.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
