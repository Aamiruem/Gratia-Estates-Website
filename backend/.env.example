# Keep DATABASE_URL credentials URL-encoded (for example, @ becomes %40).
DATABASE_URL=postgresql://estateai_aamir:Aamirazad%40786@localhost:5432/estateai

# These must match DATABASE_URL and are used only when Docker initializes a new database volume.
POSTGRES_DB=estateai
POSTGRES_USER=estateai_aamir
POSTGRES_PASSWORD=replace-with-database-password

# Generate two independent secrets with: py -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-random-64-character-hex-secret
JWT_REFRESH_SECRET_KEY=replace-with-a-different-random-64-character-hex-secret

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Exact email address of the existing account permitted to manage project videos.
VIDEO_ADMIN_EMAIL=owner@example.com

# Optional phone OTP for the video owner. Use E.164 format and keep values in
# private backend configuration. Provide either TWILIO_FROM_NUMBER or
# TWILIO_MESSAGING_SERVICE_SID.
OWNER_PHONE_NUMBER=+91XXXXXXXXXX
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Optional email OTP delivery. Without these values, email OTP is unavailable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Use secure cookies when serving over HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
