# Copy these values into frontend/.env for Vite to access the Supabase project.
# Replace with your actual project URL, anon key, and owner email.
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
VITE_VIDEO_ADMIN_EMAIL=owner@example.com
