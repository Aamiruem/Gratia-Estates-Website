# DOMAIN comes from deploy/.env, e.g. "gratiaestates.com, www.gratiaestates.com".
# Caddy gets and renews the HTTPS certificate automatically.
{$DOMAIN} {
	encode zstd gzip

	# API: the browser calls /api/*, the backend sees the path without /api.
	handle_path /api/* {
		reverse_proxy api:8000
	}

	# Website: single-page app, unknown paths fall back to index.html.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
